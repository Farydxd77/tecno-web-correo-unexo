# Copiar este archivo como .env y completar los valores reales.
# Este si se sube a GitHub: muestra que variables hacen falta, sin las claves.

# ---------- Base de datos ----------
DB_URL=jdbc:postgresql://localhost:5432/nombre_bd
DB_NAME=nombre_bd
DB_USERNAME=usuario
DB_PASSWORD=clave

# ---------- Correo (SMTP y POP3) ----------
MAIL_HOST=mail.ejemplo.com
MAIL_USERNAME=usuario
MAIL_PASSWORD=clave
MAIL_FROM=usuario@ejemplo.com
